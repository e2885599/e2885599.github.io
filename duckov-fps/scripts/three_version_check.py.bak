#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
【角色 R】技術棧監控工程師：讓 duckov-fps 持續追新 Three.js（B4「越新越好」的維運機制）。
【目標 O】讀 index.html 的 importmap 鎖定版本，對照 jsdelivr API 的 latest；
           若 latest > lock 則印告警（列出升級指令）但不自動改寫（避免靜默破壞）；
           若相等則印「已達最新」並 exit 0。
【限制 L】僅走官方 jsdelivr API（非短網址）；比較用語意化版本號；失敗（API 不可達）須非零退出。
【範例 E】對齊 code-scan-push-pipeline 的 Merkle 位元組對帳風格（此腳本只監控不寫資產）。
"""
import json
import os
import re
import sys
import urllib.request
from datetime import datetime, timezone

INDEX = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "index.html")
API = "https://data.jsdelivr.com/v1/packages/npm/three"


def parse_lock_version(html: str) -> str:
    """從 importmap 抓 three@<ver> 鎖定版。"""
    m = re.search(r"three@(\d+\.\d+\.\d+)/build/three\.webgpu\.js", html)
    return m.group(1) if m else ""


def semver_cmp(a: str, b: str) -> int:
    """語意化版本比較：a>b 回 1，a==b 回 0，a<b 回 -1。"""
    pa = [int(x) for x in a.split(".")]
    pb = [int(x) for x in b.split(".")]
    return (pa > pb) - (pa < pb)


def fetch_latest() -> str:
    req = urllib.request.Request(API, headers={"User-Agent": "duckov-fps-version-check/1.0"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.load(resp)
    return data.get("tags", {}).get("latest", "")


def main() -> int:
    with open(INDEX, "r", encoding="utf-8") as f:
        html = f.read()
    lock = parse_lock_version(html)
    if not lock:
        print("[FAIL] 無法從 index.html 解析 three 鎖定版本", file=sys.stderr)
        return 2
    try:
        latest = fetch_latest()
    except Exception as e:
        print(f"[FAIL] jsdelivr API 不可達: {e}", file=sys.stderr)
        return 1
    if not latest:
        print("[FAIL] jsdelivr 未回傳 latest", file=sys.stderr)
        return 1
    cmp = semver_cmp(lock, latest)
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H-%M-%SZ")
    if cmp < 0:
        print(f"[WARN] 鎖定 {lock} < latest {latest}（{ts}）")
        print(f"       升級指令：將 index.html importmap 三處 three@{lock} 改為 three@{latest}")
        return 0  # 監控告警但非零阻塞（交由人工授權升級，避免靜默自昇）
    elif cmp == 0:
        print(f"[OK] 技術棧已達最新：three@{lock} == latest（{ts}）")
        return 0
    else:
        print(f"[INFO] 鎖定 {lock} 高於 latest {latest}（可能預發行/本地調整）")
        return 0


if __name__ == "__main__":
    sys.exit(main())
