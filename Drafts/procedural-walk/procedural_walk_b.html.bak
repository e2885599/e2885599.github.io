<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>程序化行走 Demo（B）— Three.js 仿 UE5 蜘蛛足步</title>
<style>
  html,body{margin:0;height:100%;background:#0d1117;color:#c9d1d9;font-family:"Segoe UI",system-ui,sans-serif;overflow:hidden}
  #hud{position:fixed;top:10px;left:10px;z-index:10;background:rgba(13,17,23,.78);padding:10px 14px;border:1px solid #30363d;border-radius:8px;font-size:13px;line-height:1.6;max-width:280px}
  #hud b{color:#58a6ff}
  #hud label{display:block;margin-top:6px}
  #hud input[type=range]{width:100%}
  canvas{display:block}
</style>
</head>
<body>
<div id="hud">
  <b>程序化行走 Demo（B）</b><br>
  仿 UE5 Control Rig 蜘蛛足步系統<br>
  <label>移動速度 <input id="speed" type="range" min="0" max="6" step="0.1" value="2.5"></label>
  <label>抬腳高度 <input id="lift" type="range" min="0" max="60" step="1" value="28"></label>
  <label>步態週期(秒) <input id="cycle" type="range" min="0.3" max="2" step="0.05" value="0.9"></label>
  <span id="stat"></span>
</div>
<script src="three.min.js"></script>
<script>
// ===== 程序化行走核心（對齊字幕 T1~T11）=====
// 空間：rig space = 骨架本地（Three.js 骨世界矩陣）；world space = 場景座標
// 足步 = raycaster 向下打地面；速度 = (root - prev)/dt；抬腳 = sin(alpha*pi)
// IK = 自寫 two-bone（law of cosines + pole vector）

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x0d1117);
scene.fog = new THREE.Fog(0x0d1117, 30, 90);

const camera = new THREE.PerspectiveCamera(55, innerWidth/innerHeight, 0.1, 500);
camera.position.set(14, 12, 18);
camera.lookAt(0,0,0);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth, innerHeight);
document.body.appendChild(renderer.domElement);

// 地面（含斜坡，測試抬腳適應）
const ground = new THREE.Mesh(
  new THREE.PlaneGeometry(200,200),
  new THREE.MeshStandardMaterial({color:0x21262d, roughness:1})
);
ground.rotation.x = -Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);
const grid = new THREE.GridHelper(200, 40, 0x30363d, 0x21262d);
scene.add(grid);

// 斜坡（測試 T1 抬起）
const ramp = new THREE.Mesh(
  new THREE.BoxGeometry(20, 1, 8),
  new THREE.MeshStandardMaterial({color:0x30363d})
);
ramp.position.set(0, 0.5, -16);
ramp.rotation.x = 0.18;
ramp.receiveShadow = true;
scene.add(ramp);

scene.add(new THREE.HemisphereLight(0x88aaff, 0x202830, 0.9));
const dir = new THREE.DirectionalLight(0xffffff, 1.1);
dir.position.set(10,20,10);
scene.add(dir);

// ===== 蜘蛛骨架（程式化）=====
const BODY = new THREE.Group();
scene.add(BODY);
const pelvis = new THREE.Mesh(new THREE.SphereGeometry(1.1,16,12), new THREE.MeshStandardMaterial({color:0x8b5cf6}));
BODY.add(pelvis);

// 8 條腿：每條 root(髖)->calf(膝)->foot(踝)，均由骨名命名
const NLEG = 8;
const legs = [];
for(let i=0;i<NLEG;i++){
  const ang = (i/NLEG)*Math.PI*2;
  const hipR = 2.4;
  const hip = new THREE.Group();
  hip.position.set(Math.cos(ang)*hipR, 0, Math.sin(ang)*hipR);
  BODY.add(hip);
  const femurLen = 2.2, shinLen = 2.2;
  const root = new THREE.Mesh(new THREE.CylinderGeometry(0.12,0.12,femurLen), new THREE.MeshStandardMaterial({color:0x58a6ff}));
  const calf = new THREE.Mesh(new THREE.CylinderGeometry(0.1,0.1,shinLen), new THREE.MeshStandardMaterial({color:0x3fb950}));
  const foot = new THREE.Object3D(); // 末端 effector
  hip.add(root); hip.add(calf); hip.add(foot);
  legs.push({hip, root, calf, foot, femurLen, shinLen, ang, basePos:new THREE.Vector3()});
}

// 足步 raycaster
const ray = new THREE.Raycaster();
function groundHit(worldPoint){
  // 從 worldPoint 上方打下方
  const o = new THREE.Vector3(worldPoint.x, worldPoint.y+6, worldPoint.z);
  ray.set(o, new THREE.Vector3(0,-1,0));
  const hits = ray.intersectObjects([ground, ramp], false);
  if(hits.length) return hits[0].point.clone();
  return new THREE.Vector3(worldPoint.x, 0, worldPoint.z);
}

// 初始化：鎖定每腳世界位置
function initFeet(){
  for(const L of legs){
    L.foot.getWorldPosition(L.basePos);
    const hit = groundHit(L.basePos);
    L.locked = hit.clone();          // T2 world-locked
    L.target = hit.clone();          // 預測目標
    L.timer = (legs.indexOf(L))*0.125; // T4 偏移
  }
}
initFeet();

// 計算平均腳位置（T7 骨盆彈簧目標）
function avgFoot(){
  const v = new THREE.Vector3();
  for(const L of legs) v.add(L.locked);
  return v.multiplyScalar(1/legs.length);
}
let pelvisSpring = new THREE.Vector3(0,0,0);
let prevRoot = new THREE.Vector3();
let velocity = new THREE.Vector3();
let smoothedVel = new THREE.Vector3();

// Two-bone IK：輸入 foot 世界目標，求解膝(root/calf 旋轉 + 位置)
// 子骨(hip 的 children)必須以 BODY local 座標設定，故 world→local 轉換
const _wp = new THREE.Vector3();
const _up = new THREE.Vector3(0,1,0);
function solveIK(L, footWorldTarget){
  L.root.getWorldPosition(_wp); const rootW = _wp.clone();
  const A = rootW, C = footWorldTarget;
  const total = L.femurLen + L.shinLen;
  let d = Math.min(A.distanceTo(C), total*0.999); // 防過伸
  const a = L.femurLen, b = L.shinLen, c = d;
  const cosKnee = (a*a + b*b - c*c)/(2*a*b);
  const kneeAngle = Math.acos(THREE.MathUtils.clamp(cosKnee,-1,1));
  // 極向量（蜘蛛膝朝上）：膝位置 = 中點 + 極方向 * 偏移
  const dirAC = C.clone().sub(A).normalize();
  // 極法線 = 與 dirAC 垂直、指向 +Y 的分量
  const pole = new THREE.Vector3(0,1,0);
  let n = pole.clone().sub(dirAC.clone().multiplyScalar(pole.dot(dirAC)));
  if(n.lengthSq() < 1e-6) n.set(0,0,1); else n.normalize();
  const mid = A.clone().add(C).multiplyScalar(0.5);
  const kneeW = mid.add(n.multiplyScalar(Math.sin(kneeAngle)*a));
  // world→local（BODY 為共同父系）
  const A_loc = BODY.worldToLocal(A.clone());
  const K_loc = BODY.worldToLocal(kneeW.clone());
  const C_loc = BODY.worldToLocal(C.clone());
  placeBone(L.root, A_loc, K_loc, a);
  placeBone(L.calf, K_loc, C_loc, b);
  L.foot.position.copy(C_loc);
}
// 設置子骨：local position = from；local quaternion 對齊 +Y 到 (to-from)
function placeBone(mesh, from, to, len){
  mesh.position.copy(from);
  const dir = to.clone().sub(from).normalize();
  mesh.scale.set(1, len/mesh.geometry.parameters.height, 1);
  mesh.quaternion.setFromUnitVectors(_up, dir);
}

const clock = new THREE.Clock();
const ui = {
  speed: document.getElementById('speed'),
  lift: document.getElementById('lift'),
  cycle: document.getElementById('cycle'),
  stat: document.getElementById('stat')
};

function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  const speed = parseFloat(ui.speed.value);
  const maxLift = parseFloat(ui.lift.value);
  const cycleT = parseFloat(ui.cycle.value);

  // 身體前進（沿 +X）
  BODY.position.x += speed * dt;
  if(BODY.position.x > 40) BODY.position.x = -40;

  // 速度（T5 world space）
  const rootW = new THREE.Vector3(); pelvis.getWorldPosition(rootW);
  velocity.copy(rootW).sub(prevRoot).divideScalar(dt||1);
  smoothedVel.lerp(velocity, 0.1);
  prevRoot.copy(rootW);
  const velLen = smoothedVel.length();

  // 骨盆彈簧（T7）：目標 = 平均腳位置
  const target = avgFoot();
  // spring-damper
  const stiffness = 2.0, damping = 0.5;
  pelvisSpring.lerp(target, 1 - Math.exp(-stiffness*dt*(1-damping)));
  BODY.position.y = THREE.MathUtils.lerp(BODY.position.y, pelvisSpring.y, 0.2);

  // 每腳：計時、抬腳弧、預測
  for(const L of legs){
    L.timer += dt * (1 + velLen*0.004); // 高速加速週期
    const alpha = THREE.MathUtils.clamp(L.timer/cycleT, 0, 1);
    // 觸發重算落點
    if(L.timer >= cycleT){
      L.timer = 0;
      // 預測未來（T3/T4）：foot 當前 + 速度*預測
      const cur = L.foot.getWorldPosition(new THREE.Vector3());
      const predicted = cur.add(smoothedVel.clone().multiplyScalar(cycleT*0.6));
      const hit = groundHit(predicted);
      L.locked.copy(L.target);   // 舊目標變鎖定
      L.target.copy(hit);        // 新落點
    }
    // lerp + 抬腳（T6）：lift 依速度 clamp（靜止不抬）
    const liftScale = THREE.MathUtils.clamp(velLen/3, 0, 1) * maxLift;
    const lift = Math.sin(alpha*Math.PI) * liftScale; // auto 平滑曲線
    const interp = L.locked.clone().lerp(L.target, alpha);
    interp.y += lift;
    solveIK(L, interp);
  }

  // 骨盆跟隨平均腳高度（簡化）
  pelvis.position.y = 0;

  renderer.render(scene, camera);
  ui.stat.textContent = `速度=${velLen.toFixed(2)} 週期=${cycleT}s`;
}
animate();

addEventListener('resize', ()=>{
  camera.aspect = innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
</html>
