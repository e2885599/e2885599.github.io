#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
拉普拉斯變換一階 ODE 推導之可證偽驗算。
全部用 SymPy 符號運算實證，不依賴任何查表結論。
斷言失敗即拋 AssertionError（exit != 0），通過則印 PASS。

說明：SymPy 對廣義積分會回傳 Piecewise（附 ROC 條件），
本腳本取「收斂域內主值分支」做驗證（與筆記第 2 節 ROC 定義一致）。
"""
import sympy as sp

s, a, c, t, T = sp.symbols('s a c t T', real=True)
y0 = sp.symbols('y0', real=True, positive=True)


def main_branch(expr):
    """SymPy 廣義積分回 Piecewise 時，取第一分支（收斂域內主值）。"""
    if isinstance(expr, sp.Piecewise):
        return expr.args[0][0]
    return expr


def check(name, cond):
    # 嚴格鑑別：僅 sympy 殘差歸零(==0) 或 嚴格布林 True 視為 PASS。
    # 不用 cond == True（會讓整數 1 因 1==True 蒙混 → 靜默假通過）。
    ok = (cond == 0) or (cond is True)
    if ok:
        print(f"[PASS] {name}")
    else:
        print(f"[FAIL] {name} -> {cond}")
        raise AssertionError(name)


# 1) L{e^{at}} == 1/(s-a)（收斂域 Re(s)>Re(a) 內）
f = sp.exp(a * t)
Lf = sp.simplify(main_branch(sp.integrate(f * sp.exp(-s * t), (t, 0, sp.oo))))
print("1) 符號積分 L{e^{at}} =", Lf)
check("L{e^{at}} = 1/(s-a)", sp.simplify(Lf - 1 / (s - a)))

# 2) 導數規則：以 y(t)=e^{2t} 測試 L{y'} == sY - y(0)
yt = sp.exp(2 * t)
Y = sp.simplify(main_branch(sp.integrate(yt * sp.exp(-s * t), (t, 0, sp.oo))))
Lyp = sp.simplify(main_branch(sp.integrate(sp.diff(yt, t) * sp.exp(-s * t), (t, 0, sp.oo))))
rhs = sp.simplify(s * Y - yt.subs(t, 0))
lhs = sp.simplify(Lyp)
print(f"2) L{{y'}}={lhs},  sY-y(0)={rhs}")
check("導數規則 L{y'} = sY - y(0)", sp.simplify(lhs - rhs))

# 3) 例題二：y' - a y = e^{ct}，解 y(t)=y0 e^{at} + (e^{ct}-e^{at})/(c-a)（純代數殘差）
ysol = y0 * sp.exp(a * t) + (sp.exp(c * t) - sp.exp(a * t)) / (c - a)
resid = sp.simplify(sp.diff(ysol, t) - a * ysol - sp.exp(c * t))
print("3) 例題二殘差 y'-a y - e^{ct} =", resid)
check("例題二 ODE 滿足", resid)

# 4) 共振特例 c=a：y = y0 e^{at} + t e^{at}，應滿足 y' - a y = e^{at}
yres = y0 * sp.exp(a * t) + t * sp.exp(a * t)
resid2 = sp.simplify(sp.diff(yres, t) - a * yres - sp.exp(a * t))
print("4) 共振特例殘差 y'-a y - e^{at} =", resid2)
check("共振特例 ODE 滿足", resid2)

# 5) 收斂域反例：f(t)=e^{t^2} 的拉氏積分隨上限 T 無界增長（非收斂）
print("5) e^{t^2} 拉氏積分(數值, s=1) 隨 T 增長：")
vals = []
for Tv in [1, 2, 3, 5, 8]:
    v = float(sp.N(sp.Integral(sp.exp(t**2 - s * t), (t, 0, Tv)).subs({s: 1})))
    vals.append(v)
    print(f"   T={Tv}: 數值積分 ≈ {v:.4g}")
mono = all(vals[i] < vals[i + 1] for i in range(len(vals) - 1))
print(f"   序列遞增? {mono}; 末值 {vals[-1]:.4g} >> 初值 {vals[0]:.4g}")
check("e^{t^2} 隨 T 無界增長(收斂域為空, 方法第一步失效)", bool(mono and vals[-1] > 10 * vals[0]))

print("\n=== 全部 PASS：第一性原理推導通過可證偽驗算 ===")
